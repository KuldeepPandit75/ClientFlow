# Evolution API container environment
# Copy this file to .env.evolution before running the Docker compose stack.

# HTTP server
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://localhost:8080
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=ERROR,WARN,INFO,LOG
LOG_COLOR=true
LOG_BAILEYS=error

# Local development API key. Keep this value in sync with EVOLUTION_API_KEY
# in the server .env file.
AUTHENTICATION_API_KEY=local-dev-evolution-key
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# Instance and QR behavior
DEL_INSTANCE=false
QRCODE_LIMIT=30
CONFIG_SESSION_PHONE_CLIENT=ClientFlow
CONFIG_SESSION_PHONE_NAME=Chrome

# Postgres service from docker-compose.evolution.yml
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:evolution@evolution-postgres:5432/evolution
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true

# Redis service from docker-compose.evolution.yml
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_LOCAL_ENABLED=false

# Webhooks are configured per instance by the Next.js app.
WEBHOOK_GLOBAL_ENABLED=false
