{
  "name": "clientflow",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev ",
    "dev:whatsapp": "npm run evolution:up && next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:params": "node --test tests/feature-params.test.mjs",
    "seed:super-admin": "node scripts/seed-super-admin.mjs",
    "automation:create-business-ai": "node scripts/create-business-ai-automation.mjs",
    "evolution:repair-webhook": "node scripts/repair-evolution-webhook.mjs",
    "db:merge-businesses": "node scripts/merge-duplicate-businesses.mjs",
    "evolution:up": "docker compose -f docker-compose.evolution.yml --env-file .env.evolution up -d",
    "evolution:down": "docker compose -f docker-compose.evolution.yml --env-file .env.evolution down",
    "evolution:logs": "docker logs -f evolution_api"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.1",
    "lucide-react": "^0.462.0",
    "mongodb": "^7.2.0",
    "next": "^16.2.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  }
}
