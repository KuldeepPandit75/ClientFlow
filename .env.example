# Server environment
# Copy this file to .env.local for local Next.js development.

NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIME_ZONE=Asia/Kolkata
# Use http://localhost:3001 here when running `npm run dev:whatsapp`.

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/next-automation
MONGODB_DB=next-automation

# Auth
SESSION_COOKIE_NAME=clientflow_session
REFRESH_COOKIE_NAME=clientflow_refresh
AUTH_SECRET=replace-with-a-long-random-production-secret
CRON_SECRET=replace-with-a-long-random-cron-secret
SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=
# Set false only if you want to close new signups.
ALLOW_PUBLIC_REGISTRATION=true

# Razorpay payment gateway.
# You can also override these from the Super Admin payment settings page.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# Set true only for local learning/demo work to switch plans without payment.
BILLING_LEARNING_MODE=true

# Evolution API connection used by the Next.js server.
# When running `npm run dev:whatsapp`, Next.js starts on port 3001.
EVOLUTION_API_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=local-dev-evolution-key
EVOLUTION_INSTANCE_PREFIX=clientflow
EVOLUTION_INSTANCE_TOKEN=clientflow
EVOLUTION_AUTO_BOOTSTRAP=true
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:3000/api/webhooks/evolution
# Use http://host.docker.internal:3001/api/webhooks/evolution when running `npm run dev:whatsapp`.
EVOLUTION_WEBHOOK_SECRET=local-dev-webhook-secret
DATA_ENCRYPTION_KEY=replace-with-strong-encryption-secret
DATA_ENCRYPTION_KEY_VERSION=v1
DATA_ENCRYPTION_KEY_OLD=
EVOLUTION_WEBHOOK_BY_EVENTS=true
COMPLIANCE_QUIET_HOURS_ENABLED=false
COMPLIANCE_QUIET_HOURS_START=22
COMPLIANCE_QUIET_HOURS_END=8

# AI replies for WhatsApp automations.
# Set AI_PROVIDER=openrouter, AI_PROVIDER=groq, or AI_PROVIDER=custom (any OpenAI-compatible API).
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# For custom providers (VyceAI, Together, etc.):
# AI_PROVIDER=custom
# AI_BASE_URL=https://vyceai.com/v1
# AI_API_KEY=your-key
# AI_MODEL=your-model
AI_APP_TITLE=ClientFlow WhatsApp Automation
